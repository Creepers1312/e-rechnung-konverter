# Copy to .env and adjust. .env is git-ignored.

# Database (use letters/digits only in the password; it is part of a URL)
POSTGRES_DB=erechnung
POSTGRES_USER=erechnung
POSTGRES_PASSWORD=bitte-aendern

# First administrator, created on first start while no user exists.
# The password must be changed at the first login; afterwards these two
# values are ignored and can be removed.
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern-123

# Login sessions
# true once the app is served via HTTPS (cookie only sent over HTTPS)
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Port of the web UI on the host
HTTP_PORT=8080

# SAP ECC IDoc inbox: host folder with inbox/ outbox/ processed/ error/
# (on/off, format and interval are set by an admin in the web UI;
#  the two values below are only the defaults until then)
IDOC_HOST_DIR=./data/idoc
# PDF inbox (scanner, file share): host folder with inbox/ outbox/ processed/ error/
PDF_HOST_DIR=./data/pdf
# SAP customer master (CSV export of an SAP Query, daily): host folder with inbox/ processed/ error/
STAMMDATEN_HOST_DIR=./data/stammdaten
# zugferd or xrechnung
IDOC_PROFILE=zugferd
# poll interval in seconds
IDOC_INTERVAL=10

# Database backups (service "backup"): host folder, daily time (UTC), retention
BACKUP_HOST_DIR=./backups
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

# Checkmk local check (installed by deploy.sh when a Checkmk agent is present)
# CHECKMK_BACKUP_WARN_HOURS=26
# CHECKMK_BACKUP_CRIT_HOURS=50
# CHECKMK_INBOX_STALE_MINUTES=15

# Text recognition for scanned PDFs (service "ocr"): Tesseract languages, parallel documents
OCR_LANG=deu+eng
OCR_PARALLEL=2
# ZUGFeRD files are converted to PDF/A-3 and checked with veraPDF (service "ocr") before
# release. Without a passed check nothing is released. "off" disables it (not for production).
PDFA_CHECK=on
